        [parameters_AVGARCH_SKEWT, LLF_AVGARCH_SKEWT, stderrors_AVGARCH_SKEWT, robustSE_AVGARCH_SKEWT, ht_AVGARCH_SKEWT, scores_AVGARCH_SKEWT, resid_AVGARCH_SKEWT, likelihood_AVGARCH_SKEWT, EXITFLAG]=ar_multigarch_grm(data(:,j),1,0,1,'AVGARCH','SKEWT',nAVGARCH_SKEWT(j),const);
        if any(isnan(parameters_AVGARCH_SKEWT))
        [parameters_AVGARCH_SKEWT, LLF_AVGARCH_SKEWT, stderrors_AVGARCH_SKEWT, robustSE_AVGARCH_SKEWT, ht_AVGARCH_SKEWT, scores_AVGARCH_SKEWT, resid_AVGARCH_SKEWT, likelihood_AVGARCH_SKEWT, EXITFLAG]=ar_multigarch_grm(data(:,j),1,0,1,'GARCH','SKEWT',nAVGARCH_SKEWT(j),const);
        end
        BIC_AVGARCH_SKEWT = 2*LLF_AVGARCH_SKEWT+log(t)*size(parameters_AVGARCH_SKEWT,1);
        Tstatistic_AVGARCH_SKEWT=parameters_AVGARCH_SKEWT./diag(robustSE_AVGARCH_SKEWT).^0.5;
        % H0: keine autocorrelation - in diesem Fall der quadrierten
        % standardisierten Residuen
        stdresid = resid_AVGARCH_SKEWT./sqrt(ht_AVGARCH_SKEWT);
        result_stderrors_AVGARCH_SKEWT=lmtest2(stdresid,10);
        % H0: angenommene Verteilugn für ML-Schätzung entspricht der wahren
        % Verteilung (in diesem Fall der SKEWT; 0: H0 wird nicht abgelehnt; 1: H0
        % wird abgelehnt
        if any(isnan(parameters_AVGARCH_SKEWT))
            stat_Kolmogorov_resid='NAN';
            siglevel_Kolmogorov_resid='NAN';
            H_Kolmogorov_resid ='NAN';
        else
            [stat_Kolmogorov_resid, siglevel_Kolmogorov_resid, H_Kolmogorov_resid]=kolmogorov(stdresid,.05,'skewtdis_cdf',parameters_AVGARCH_SKEWT(end-1), parameters_AVGARCH_SKEWT(end));
        end
        if any(isnan(parameters_AVGARCH_SKEWT))
            U_AVGARCH_SKEWT = 1;
        else
            U_AVGARCH_SKEWT = skewtdis_cdf(stdresid,parameters_AVGARCH_SKEWT(end-1),parameters_AVGARCH_SKEWT(end));
        end
        U_rnd = random('unif',0,1,size(U_AVGARCH_SKEWT,1),1);
        [h,pKolmogorov,stat_Kolmogorv_U] = kstest2(U_AVGARCH_SKEWT,U_rnd,0.05);
        if any(isnan(parameters_AVGARCH_SKEWT))
            stat_Kolmogorov_U='NAN';
            siglevel_Kolmogorov_U='NAN';
            H_Kolmogorov_U='NAN';
        else
            [stat_Kolmogorov_U, siglevel_Kolmogorov_U, H_Kolmogorov_U]=kolmogorov(U_AVGARCH_SKEWT,.05,'unifcdf',0,1);
        end
        Output_AVGARCH_SKEWT{j}.U_AVGARCH_SKEWT_mean = U_AVGARCH_SKEWT-mean(U_AVGARCH_SKEWT);
        Output_AVGARCH_SKEWT{j}.U_AVGARCH_SKEWT_mean2 = (U_AVGARCH_SKEWT-mean(U_AVGARCH_SKEWT)).^2;
        Output_AVGARCH_SKEWT{j}.U_AVGARCH_SKEWT_mean3 = (U_AVGARCH_SKEWT-mean(U_AVGARCH_SKEWT)).^3;
        Output_AVGARCH_SKEWT{j}.U_AVGARCH_SKEWT_mean4 = (U_AVGARCH_SKEWT-mean(U_AVGARCH_SKEWT)).^4;
        % H0: Zeitreihe ist strict white noise; H=0 Nullhypothese wird akzeptiert
        [H_AVGARCH_SKEWT_swn,pValue,Qstat,CriticalValue] = lbqtest(stdresid,10,.05,[]);
        Output_AVGARCH_SKEWT{j}.H_swn=H_AVGARCH_SKEWT_swn;
        Output_AVGARCH_SKEWT{j}.pValue{j}=pValue;
        Output_AvGARCH_SKEWT{j}.Qstat{j}=Qstat;
        Output_AVGARCH_SKEWT{j}.CriticalValue{j}=CriticalValue;
        Output_AVGARCH_SKEWT{j}.Params=parameters_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.ParamsGARCH = [parameters_AVGARCH_SKEWT(1:end-nAVGARCH_SKEWT(j)-const-2);parameters_AVGARCH_SKEWT(end-1:end)] ;
        Output_AVGARCH_SKEWT{j}.ParamsAR = parameters_AVGARCH_SKEWT(size(Output_AVGARCH_SKEWT{j}.ParamsGARCH,1)-2+1:size(parameters_AVGARCH_SKEWT,1)-2);
        Output_AVGARCH_SKEWT{j}.LLF=LLF_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.stderrors=stderrors_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.robustSE=robustSE_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.ht=ht_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.Scores=scores_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.Innovations=resid_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.GARCH = 'AVGARCH';
        Output_AVGARCH_SKEWT{j}.U = U_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.Tstat = Tstatistic_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.garchtype = 3;
        Output_AVGARCH_SKEWT{j}.leverage = 1;
        Output_AVGARCH_SKEWT{j}.errortype = 4;
        Output_AVGARCH_SKEWT{j}.arlag = nAVGARCH_SKEWT(j);
        Output_AVGARCH_SKEWT{j}.likelihoods = likelihood_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.EXITFLAG = EXITFLAG;
        Output_AVGARCH_SKEWT{j}.data = data(:,j);
        Output_AVGARCH_SKEWT{j}.dist = 'SKEWT';
        Output_AVGARCH_SKEWT{j}.Innovations = resid_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.BIC = BIC_AVGARCH_SKEWT;
        Output_AVGARCH_SKEWT{j}.stdresid = stdresid;
        Output_AVGARCH_SKEWT{j}.statKolmResid = stat_Kolmogorov_resid;
        Output_AVGARCH_SKEWT{j}.siglevelKolmResid = siglevel_Kolmogorov_resid;
        Output_AVGARCH_SKEWT{j}.HKolmResid = H_Kolmogorov_resid;
        Output_AVGARCH_SKEWT{j}.statKolmU= stat_Kolmogorov_U;
        Output_AVGARCH_SKEWT{j}.siglevelKolmU = siglevel_Kolmogorov_U;
        Output_AVGARCH_SKEWT{j}.HKolmU = H_Kolmogorov_U;
        Output_AVGARCH_SKEWT{j}.pKol = pKolmogorov;
        if const == 1
            Output_AVGARCH_SKEWT{j}.const = 1;
        else
            Output_AVGARCH_SKEWT{j}.const = 0;
        end
end


% -------------------------------------------------------------------------
% -------------------------------------------------------------------------
% -------------------------------------------------------------------------
% generiere grafiken
% Diebold et al autokorrelation von z-mean(z),
% z-mean(z).^2,z-mean(z).^3,z-mean(z).4
% -------------------------------------------------------------------------
% -hie für Gaußsche-Verteilung
for j =1:k
    [ACF_GARCH_Gauss_mean1{j},Lags_GARCH_Gauss{j},Bounds_GARCH_Gauss_mean1{j}] = autocorr(Output_GARCH_Gauss{j}.U_GARCH_Gauss_mean,99);
    [ACF_EGARCH_Gauss_mean1{j},Lags_EGARCH_Gauss{j},Bounds_EGARCH_Gauss_mean1{j}] = autocorr(Output_EGARCH_Gauss{j}.U_EGARCH_Gauss_mean,99);
    [ACF_TGARCH_Gauss_mean1{j},Lags_TGARCH_Gauss{j},Bounds_TGARCH_Gauss_mean1{j}] = autocorr(Output_TGARCH_Gauss{j}.U_TGARCH_Gauss_mean,99);
    [ACF_GJRGARCH_Gauss_mean1{j},Lags_GJRGARCH_Gauss{j},Bounds_GJRGARCH_Gauss_mean1{j}] = autocorr(Output_GJRGARCH_Gauss{j}.U_GJRGARCH_Gauss_mean,99);
    [ACF_AVGARCH_Gauss_mean1{j},Lags_AVGARCH_Gauss{j},Bounds_AVGARCH_Gauss_mean1{j}] = autocorr(Output_AVGARCH_Gauss{j}.U_AVGARCH_Gauss_mean,99);
    [ACF_GARCH_Gauss_mean2{j},Lags_GARCH_Gauss{j},Bounds_GARCH_Gauss_mean2{j}] = autocorr(Output_GARCH_Gauss{j}.U_GARCH_Gauss_mean2,99);
    [ACF_EGARCH_Gauss_mean2{j},Lags_EGARCH_Gauss{j},Bounds_EGARCH_Gauss_mean2{j}] = autocorr(Output_EGARCH_Gauss{j}.U_EGARCH_Gauss_mean2,99);
    [ACF_TGARCH_Gauss_mean2{j},Lags_TGARCH_Gauss{j},Bounds_TGARCH_Gauss_mean2{j}] = autocorr(Output_TGARCH_Gauss{j}.U_TGARCH_Gauss_mean2,99);
    [ACF_GJRGARCH_Gauss_mean2{j},Lags_GJRGARCH_Gauss{j},Bounds_GJRGARCH_Gauss_mean2{j}] = autocorr(Output_GJRGARCH_Gauss{j}.U_GJRGARCH_Gauss_mean2,99);
    [ACF_AVGARCH_Gauss_mean2{j},Lags_AVGARCH_Gauss{j},Bounds_AVGARCH_Gauss_mean2{j}] = autocorr(Output_AVGARCH_Gauss{j}.U_AVGARCH_Gauss_mean2,99);
    [ACF_GARCH_Gauss_mean3{j},Lags_GARCH_Gauss{j},Bounds_GARCH_Gauss_mean3{j}] = autocorr(Output_GARCH_Gauss{j}.U_GARCH_Gauss_mean3,99);
    [ACF_EGARCH_Gauss_mean3{j},Lags_EGARCH_Gauss{j},Bounds_EGARCH_Gauss_mean3{j}] = autocorr(Output_EGARCH_Gauss{j}.U_EGARCH_Gauss_mean3,99);
    [ACF_TGARCH_Gauss_mean3{j},Lags_TGARCH_Gauss{j},Bounds_TGARCH_Gauss_mean3{j}] = autocorr(Output_TGARCH_Gauss{j}.U_TGARCH_Gauss_mean3,99);
    [ACF_GJRGARCH_Gauss_mean3{j},Lags_GJRGARCH_Gauss{j},Bounds_GJRGARCH_Gauss_mean3{j}] = autocorr(Output_GJRGARCH_Gauss{j}.U_GJRGARCH_Gauss_mean3,99);
    [ACF_AVGARCH_Gauss_mean3{j},Lags_AVGARCH_Gauss{j},Bounds_AVGARCH_Gauss_mean3{j}] = autocorr(Output_AVGARCH_Gauss{j}.U_AVGARCH_Gauss_mean3,99);
    [ACF_GARCH_Gauss_mean4{j},Lags_GARCH_Gauss{j},Bounds_GARCH_Gauss_mean4{j}] = autocorr(Output_GARCH_Gauss{j}.U_GARCH_Gauss_mean4,99);
    [ACF_EGARCH_Gauss_mean4{j},Lags_EGARCH_Gauss{j},Bounds_EGARCH_Gauss_mean4{j}] = autocorr(Output_EGARCH_Gauss{j}.U_EGARCH_Gauss_mean4,99);
    [ACF_TGARCH_Gauss_mean4{j},Lags_TGARCH_Gauss{j},Bounds_TGARCH_Gauss_mean4{j}] = autocorr(Output_TGARCH_Gauss{j}.U_TGARCH_Gauss_mean4,99);
    [ACF_GJRGARCH_Gauss_mean4{j},Lags_GJRGARCH_Gauss{j},Bounds_GJRGARCH_Gauss_mean4{j}] = autocorr(Output_GJRGARCH_Gauss{j}.U_GJRGARCH_Gauss_mean4,99);
    [ACF_AVGARCH_Gauss_mean4{j},Lags_AVGARCH_Gauss{j},Bounds_AVGARCH_Gauss_mean4{j}] = autocorr(Output_AVGARCH_Gauss{j}.U_AVGARCH_Gauss_mean4,99);
end

