% % % % % mit Gauss-Verteilung
for j=1:4
    subplot(4,1,j)
    h = stem(Lags_GARCH_Gauss{j}(2:end),Brazil_ACF_GRGARCH_Gauss{j}(2:end),'fill','--');
    set(get(h,'BaseLine'),'LineStyle',':')
    set(h,'MarkerFaceColor','red')
    hold('on')
    plot(repmat(Bounds_TGARCH_Gauss_mean1{j}(1),99,1));
    plot(repmat(Bounds_TGARCH_Gauss_mean1{j}(2),99,1));
    hold('off')
end

