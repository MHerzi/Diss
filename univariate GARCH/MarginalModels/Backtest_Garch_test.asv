% % Backtest mit mehrmals kalibriereden GARCH-Modellen


clear all
% % Lese Zeitreihe ein
cd G:\Daten
y = xlsread('Hedge_HFRX_20090611',1);
x=price2ret(y(:,2));

% abrunden, damit durch entsprechende forecast-Anzahl geteilt werden kann
t=1200;

% Anzahl der Perioden für die "forecast" gemacht werden soll
forecastP = 5;
% 1.fange bei 520 Tagen an und schätze jeden Monat ein neues Modell unter
% Berücksichtigung aller Daten bis zu diesem Zeitpunkt
% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% GARCH
k=1;
arlag=1;
const = 1;
for i=500:5:t
    [parameters_GARCH_Gauss_add{k}, LLF_GARCH_Gauss_add{k}, stderrors_GARCH_Gauss_add{k}, robustSE_GARCH_Gauss_add{k}, ht_GARCH_Gauss_add{k}, scores_GARCH_Gauss_add{k}, resid_GARCH_Gauss_add{k}]=ar_multigarch_grm(x(1:i),1,0,1,'GARCH','NORMAL',arlag,const);
    k=k+1;
end

% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% TGARCH
k=1;
arlag=1;
const = 1;
for i=520:5:t
    [parameters_TGARCH_Gauss_add{k}, LLF_TGARCH_Gauss_add{k}, stderrors_TGARCH_Gauss_add{k}, robustSE_TGARCH_Gauss_add{k}, ht_TGARCH_Gauss_add{k}, scores_TGARCH_Gauss_add{k}, resid_TGARCH_Gauss_add{k}]=ar_multigarch_grm(x(1:i),1,1,1,'TGARCH','NORMAL',arlag,const);
    k=k+1;
end

% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% EGARCH
k=1;
arlag=1;
const = 1;
for i=520:5:t
    [parameters_EGARCH_Gauss_add{k}, LLF_EGARCH_Gauss_add{k}, stderrors_EGARCH_Gauss_add{k}, robustSE_EGARCH_Gauss_add{k}, ht_EGARCH_Gauss_add{k}, scores_EGARCH_Gauss_add{k}, resid_EGARCH_Gauss_add{k}]=ar_multigarch_grm(x(1:i),1,1,1,'EGARCH','NORMAL',arlag,const);
    k=k+1;
end

% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% EGARCH
k=1;
arlag=1;
const = 1;
for i=520:5:t
    [parameters_GJRGARCH_Gauss_add{k}, LLF_GJRGARCH_Gauss_add{k}, stderrors_GJRGARCH_Gauss_add{k}, robustSE_GJRGARCH_Gauss_add{k}, ht_GJRGARCH_Gauss_add{k}, scores_GJRGARCH_Gauss_add{k}, resid_GJRGARCH_Gauss_add{k}]=ar_multigarch_grm(x(1:i),1,1,1,'EGARCH','NORMAL',arlag,const);
    k=k+1;
end

[xti, forecastMean] = ar_forecast(x,parameters_GARCH_Gauss_add,arlag,const,5,519);

% Vola forecast

[htForecast,htForecastModel] = ar_volaForecast(parameters_GARCH_Gauss_add,resid_GARCH_Gauss_add,519,ht_GARCH_Gauss_add,5,1,0,1,'GARCH');



% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
% % % % % % %
% 1.fange bei 520 Tagen an und schätze jeden Monat ein neues Modell
% rollierend für jeden Monat
k=1;
h=1;
for i=520:forecastP:t
    [parameters_GARCH_Gauss_roll{h}, LLF_GARCH_Gauss_roll{h}, stderrors_GARCH_Gauss_roll{h}, robustSE_GARCH_Gauss_roll{h}, ht_GARCH_Gauss_roll{h}, scores_GARCH_Gauss_roll{h}, resid_GARCH_Gauss_roll{h}]=ar_multigarch_grm(x(k:i),1,0,1,'GARCH','NORMAL',1,1);
    k=k+5;
    h=h+1;
end
% "Anleitung"
% 1. Bilde neue Residuen mit den geschätzten AR-Parametern - über den gesamten
% Zeitraum, aber für das jeweilige Modell
% 2. bilde den "forecast" konditioniert auf die letzte geschätzte Varianz
% mit den jeweiligen Residuen aus 1.
for j=1:size(ht_GARCH_Gauss_roll,2)
    for i=520:520+forecastP-1
        data_resid_new = [ones(size(x,1),1) x];
        data_resid_new = mlag(data_resid_new,arlag-1,0);
        resid_new = trimr(x,1,0) - (parameters_GARCH_Gauss_roll{j}(size(parameters_GARCH_Gauss_roll{j},1)-arlag+1:end)'*trimr(data_resid_new,arlag-1,0)')';
        ht_new{j}(519) = ht_GARCH_Gauss_roll{j}(end);
        ht_GARCH_Gauss_roll{j}(i) = parameters_GARCH_Gauss_roll{j}(1) + parameters_GARCH_Gauss_roll{j}(2)*resid_new(i-1).^2+parameters_GARCH_Gauss_roll{j}(3)* ht_new{j}(i-1);
        ht_new{j}(i)=ht_GARCH_Gauss_roll{j}(i);
    end
end


f=519;
for j=1:size(ht_GARCH_Gauss_roll,2)
    ht_new{j}(f) = ht_GARCH_Gauss_roll{j}(end);
    index = 0:arlag;
    for i=520:520+forecastP
        if f+1 == i
            xti = x(1:i-1);
            if const == 0 && arlag > 1
                xti_new = [xti mlag(xti,arlag)];
            elseif const == 1
                if arlag == 1
                    xti_new = [ones(i-1,1) x(1:i-1)];
                elseif arlag >1
                    xti_new = [ones(i-1,1) xti mlag(xti,arlag-1)];
                end
            end
        end
        if arlag == 1
            if const == 0
                xti(i) = parameters_GARCH_Gauss_roll{j}(end)*xti(i-1,:);
            else
                xti(i) = parameters_GARCH_Gauss_roll{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
                xti_new(i,:) = [1 xti(i)];
            end
            resid(i) = xti(i) - parameters_GARCH_Gauss_roll{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
        elseif arlag > 1
            xti(i) = parameters_GARCH_Gauss_roll{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
            if const == 1
                for h=1:arlag
                    xti2(h) = xti(end-index(h));
                end
                xti_new(i,:) = [1 xti2];
            else
                for h=1:arlag
                    xti2(h) = xti(end-index(h));
                end
                xti_new = xti2;
            end
            resid(i) = xt(i)-parameters_GARCH_Gauss_roll{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
        end
        ht_GARCH_Gauss_roll{j}(i) = parameters_GARCH_Gauss_roll{j}(1) + resid(i-1).^2+parameters_GARCH_Gauss_roll{j}(3)* ht_new{j}(i-1);
        ht_new{j}(i)=ht_GARCH_Gauss_roll{j}(i);
    end
    f=f+forecastP;
end


ht_GARCH_out_roll = ht_GARCH_Gauss_roll{1};
% Out-of sample kumuliert: ab Periode 526 nur noch out-of-sample
h=525;
for j=2:size(ht_GARCH_Gauss_roll,2)
    ht_GARCH_out_roll(h:h+4) = ht_GARCH_Gauss_roll{j}(520:end);
    h=h+5;
end

% Figures
plot(sqrt(ht_GARCH_out_roll(520:end))); title('Out-of-sample roll')
figure;plot(sqrt(ht_GARCH_out_roll(520:end)));  title('Out-of-sample roll')
