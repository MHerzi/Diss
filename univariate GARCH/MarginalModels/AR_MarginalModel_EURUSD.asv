% Hansen skew-t GARCH
for i=1:5
    [parameters_skewt, likelihood_skewt(i), stderrors_skewt, robustSE_skewt, ht_skewt, scores_skewt, resid_skewt] = ar_skewt_garch_grm(x , 1 , 1 ,i);
    BIC_skewt(i) = -2*likelihood_skewt(i)+2*log(t)*size(parameters_skewt,1);
end
[m,n] = min(BIC_skewt);
[parameters_skewt, likelihood_skewt, stderrors_skewt, robustSE_skewt, ht_skewt, scores_skewt, resid_skewt] = ar_skewt_garch_grm(x , 1 , 1 ,n);
BIC_skewt = -2*likelihood_skewt+2*log(t)*size(parameters_skewt,1);
Tstatistic_skwet=parameters_skewt./diag(robustSE_skewt).^0.5;
stdresid = resid_skewt(n+1:end)./sqrt(ht_skewt);
result_stderrors_sket=lmtest2(stdresid,10);
[statistic_skewt, siglevel_skewt, KolmH_skewt]=kolmogorov(stdresid,.05,'norm_cdf');
U_skewt = zeros(size(stdresid,1),1);
for i = 1:size(stdresid,1)
    U_skewt(i,:) = skewtdis_cdf(stdresid(i),parameters_skewt(1+1+1+1), parameters_skewt(1+1+1+2));
end
U_skewt_mean = U_skewt-mean(U_skewt);
U_skewt_mean2 = (U_skewt-mean(U_skewt)).^2;
U_skewt_mean3 = (U_skewt-mean(U_skewt)).^3;
U_skewt_mean4 = (U_skewt-mean(U_skewt)).^4;
% H0: Zeitreihe ist strict white noise; H=0 Nullhypothese wird akzeptiert
[H_skewt_swn,pValue_skewt_swn,Qstat_skewt_swn,CriticalValue_skewt_sw] = lbqtest(stdresid,10,.05,[]);

