function [P,kappa4] = Frank_gof_tv(data)
% Goodness-of-fit test für die Placket-Copula
% Input: Ein Tx2 Datenvektor (Returnzeitreihe)
% Output: P-value
%         Parameter der Placket-Copula geschätzt mit empirischer
%         Marginalverteilung
% Autor: Martin Grziska

% Anzahl der Simulationens
N=100;
% Berechne empirische Marginalverteilung
[t,k]=size(data);
U = empiricalCopula(data);
V = empiricalCDF(data);

% Schätzen der Frank-Copula
theta0 = 1;
options = optimset('Display','iter','TolCon',10^-12,'TolFun',10^-4,'TolX',10^-6);
[ kappa5 LL5] = fminunc('frankCL',theta0,options,[V(:,1),V(:,2)]);

% Schätzen der zeitvariierenden Frank-Copula
theta0 = [.5;0;0];
[ kappa14 LL14] =fminunc('bivfrank_tvp1_CL_neu_patton',theta0,[],V,kappa5);
[LL42, rho5_tv] = bivfrank_tvp1_CL_neu_patton(kappa14,V, kappa5);

% generiere Zufallsvariablen U der zeitvariierenden Frank-Copula am aktuellen Rand
[uFrank] = frank_rnd(rho5_tv(end),t,1);

% Approximiere parametrische Copula
B = empiricalCopula(uFrank);

% Approximiere S
S = sum((U - B).^2);

% generiere Zufallsvariablen U der Frank-Copula
for i=1:2:N
[uFrank2(:,i:i+1)] = frank_rnd(rho5_tv(end),t,i);
end

% Berechne empirische Copula der Pseudovariablen
k=1;
for i=1:2:N
U3(:,k)=empiricalCopula(uFrank2(:,i:i+1));
k=k+1;
end
% Berechne zeitvariierende Frank-Copula für die Pseudovariablen
theta0 = [.5;0;0];
for i=1:2:N
[ kappa5_tv(:,i) LL5_tv] = fmincon('bivfrank_tvp1_CL_neu_patton',theta0,[],[],[],[],lower,upper,[],options,uFrank2(:,i:i+1),rho4_tv(end));
[ kappa5_tv LL5_tv] =fminunc('bivfrank_tvp1_CL_neu_patton',theta0,[],[u,v],rho);
[LL53, rho52_tv(:,i)] = bivfrank_tvp1_CL_neu_patton(kappa5_tv(:,i),uFrank2(:,i:i+1), rho5_tv(end));
end
% generiere Zufallsvariablen U der Frank-Copula
for i=1:2:N
[uFrank3(:,i:i+1)] = frank_rnd(rho42_tv(end,i),t,1);
end
% Approximiere parametrische Verteilung
k=1;
for i=1:2:N
B3(:,k)= empiricalCopula(uFrank3(:,i:i+1));
k=k+1;
end

% Approximiere S
S2 = sum((U3- B3).^2);

for i=1:size(S2,2)
count(i)=S2(i)>S(1);
end

P = sum(count)./(N/2);