function [xti, forecastMean] = ar_forecast(data,params,arlag,const,forecastP,f)
% Forecast of conditional mean for AR(k)-GARCH models
% INPUTS:
%               data:       tx1 vector of returns
%               params:     cell-array with estimated GARCH-Parameters
%               arlag:      # of lags in AR(k)-GARCH
%               const:      0 if AR(k)-GARCH was estimated without constant, else 1
%               forecastP:  forecast horizon
%               f:          last elemnt which is NOT forecasted (in xti)
% OUTPUTS:
%              xti:         tx1 Vector of forecasted conditional means; forecast
%                           starts at f+1
%             forecastMean: cell-array which contains the forecasted
%                           conditional mean for each estimated GARCH model
% Author: Martin Grziska, 03/10/2010

% Forecast des conditional mean über forecastP-Perioden (rekursive Methode,
% d.h. yt und forecasts werden immer wieder eingesetzt; in xti steht
% letztendlich ab Zeile 520 der gesamte forecast, wobei ein GARCH-Modell
% die Vorhersage für forecastP Tage macht, dann wird neu kalibiriert und
% eine neue vorhersage für forecastP-Tage wird gemacht

forecastMean=cell(1,size(params,2));
xti = data(1:f);

for j=1:size(params,2)
    index = 0:arlag;
    for i=f+1:f+forecastP
        if f+1 == i
            %             jedes GARCH-Modell verwendet Zeitreihe bis zum Zeitpunkt f,
            %             darauf wird der forecast konditioniert; diese matrix wird
            %             hier für jedes GARCH-Modell gebildet
            if const == 1
                if arlag == 1
                    xti_new = [params{j}(end-arlag-const+1:end)'*[ones(f,1) data(1:i-1)]']';
                else
                    xti_new = [params{j}(end-arlag-const+1:end)'*[ones(f,1) mlag(data(1:i-1),arlag)]']';
                end
            else
                if arlag == 1
                    xti_new = [params{j}(end-arlag-const+1:end)'*[data(1:i-1)]']';
                else
                    xti_new = [params{j}(end-arlag-const+1:end)'*[mlag(data(1:i-1),arlag)]']';
                end
            end
            if const == 0 && arlag > 1
                %                 xti geht von 1:f, i=f+1
                xti_new = [xti mlag(xti(1:i-1),arlag-1)];
            elseif const == 1
                %                     füge spalte einsen hinzu für Regeression mit Konstante
                if arlag == 1
                    xti_new = [ones(i-1,1) data(1:i-1)];
                elseif arlag >1
                    xti_new = [ones(i-1,1) data mlag(data,arlag-1)];
                end
            end
        end
        %         Im Folgenden werden die forecast rekursiv gebildet; xti:
        %         letzendliche Matrix, die den forecast enthält; xti_new: matrix
        %         die die rekursiv ermittelten Werte enthält
        if arlag == 1
            if const == 0
                xti(i) = params{j}(end)*xti(i-1,:);
            else
                xti(i) = params{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
                xti_new(i,:) = [1 xti(i)];
            end
        elseif arlag > 1
            xti(i) = params{j}(end-arlag-const+1:end)'*xti_new(i-1,:)';
            if const == 1
                for h=1:arlag
                    %                     xti2 schreibt die Werte aus xti in die richtige
                    %                     Reihenfolge: der unterste Wert in xti ist der neueste
                    %                     und muss somit als erster Term in der
                    %                     regressionsgleichung auftauchen
                    xti2(h) = xti(end-index(h));
                end
                xti_new(i,:) = [1 xti2];
            else
                for h=1:arlag
                    xti2(h) = xti(end-index(h));
                end
                xti_new(i,:) = xti2;
            end
        end
    end
    forecastMean{j}=xti(f+1:f+forecastP);
    f=f+forecastP;
end

index=2:forecstP;

consti = params{j}(1);
paramsi = params{j}(end-arlag-const+1:end);
for i=1:size(paramsi)
    paramsii = repmat(paramsi)

% Schneide die durch AR verlorenegegangene Beobachtungen ab
xti = trimr(xti,arlag-1,0);


% AR-forecast mit Parameters Enders(1995)"Apllied time series
% Econometrics", S.80

