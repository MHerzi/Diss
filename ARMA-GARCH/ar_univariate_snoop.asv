function [AR_pred,ht_pred, resid_pred] = ar_univariate_snoop(data,GARCH,const)
% Data-snooping "forecast": split whole sample in estimation and forecast
% period; use AR and GARCH-parameters from estimation period to predict
% values in forecastin period
%
% USAGE:   [AR_pred,ht_pred] = ar_univariate_snoop(data,GARCH,const)
%
% INPUTS:
%          GARCH: structure containing parameters etc from univariate
%                 GARCH estimated by AR_MArignalModel.m; sample already
%                 splitted: coefficients already estimated by sample
%                 determined for estimation
%          data: t x k array of return series (complete series)
%          const: 1 if AR-GARCH is estimated with const, 0 else
%
% OUTPUTS:
%          ht_pred:    predicted vola
%          AR_pred:    predicted residuals
%          resid_pred: residuals - data-AR 
%
% Author: Martin Grziska, 04/10/2010

[t,k] = size(data);

% -----------------------------------------------------------------------
% AR-process
% -----------------------------------------------------------------------
lagdata=cell(k,1);
lagdata2=cell(k,1);
AR_pred=cell(k,1);
resid_pred = cell(k,1);
% lag data corresponding to arlags
for i=1:k
    lagdata{i} = mlag(data(:,i),GARCH{i}.arlag);
    %     cut for observations lost due to AR-estimation
    lagdata{i} = trimr(lagdata{i},GARCH{i}.arlag,0);
end

% add column of ones if const
if const == 1
    for i=1:k
        lagdata2{i} = [ones(size(lagdata{i},1),1) lagdata{i}];
    end
end

%     cut original data for observations lost due to AR-estimation
for i=1:k
    data_new{i} = trimr(data(:,i),GARCH{i}.arlag,0);
end
% regress estimated coefficients and infer residuals
for i=1:k
    AR_pred{i} = GARCH{i}.ParamsAR'*lagdata2{i}';
    resid_pred{i} = data_new{i} - AR_pred{i}';
end
% ------------------------------------------------------------------------


% ------------------------------------------------------------------------
% GARCH-process
% ------------------------------------------------------------------------
% create new ht_variable which last elemtn can be used in recursive
% estimation of predicted ht's
ht_pred=cell(k,1);
for i=1:k
    ht_pred{i} = GARCH{i}.ht;
end
% use recursive routine to predict ht with estimated (fixed) GARCH
% coeffcients
for i=1:k
    for j=size(ht_pred{i},1)+1:size(data_new{i},1);
        if strcmp(GARCH{i}.GARCH,'GARCH') == 1
            ht_pred{i}(j,:) = GARCH{i}.ParamsGARCH(1) + GARCH{i}.ParamsGARCH(2)*resid_pred{i}(j,1).^2 + GARCH{i}.ParamsGARCH(3)*ht_pred{i}(j-1);
        elseif strcmp(GARCH{i}.GARCH,'EGARCH') == 1
%             EGARCH parameters = ht = omega + gamma + alpha + beta!!!
            ht_pred{i}(j,:) = exp(GARCH{i}.ParamsGARCH(1) + GARCH{i}.ParamsGARCH(3)*abs(resid_pred{i}(j,1))./sqrt(ht_pred{i}(j-1)) + GARCH{i}.ParamsGARCH(2)*lagdata{i}(j,1)./sqrt(ht_pred{i}(j-1)) + GARCH{i}.ParamsGARCH(4)*log(ht_pred{i}(j-1)));
        elseif strcmp(GARCH{i}.GARCH,'TGARCH') == 1
            %             Cappiello et al (2006): TGARCH models sqrt of ht
            ht_pred{i}(j-1) = sqrt(ht_pred{i}(j-1));
            if lagdata{i}(j,1)>0
                lagdata{i}(j,1)=0;
            end
            ht_pred{i}(j,:) =    GARCH{i}.ParamsGARCH(1) + GARCH{i}.ParamsGARCH(2)*abs(resid_pred{i}(j,1)) + GARCH{i}.ParamsGARCH(3)*lagdata{i}(j,1)+GARCH{i}.ParamsGARCH(4)*ht_pred{i}(j-1);
            ht_pred{i}(j,:) = ht_pred{i}(j,:).^2;
        elseif strcmp(GARCH{i}.GARCH,'GJRGARCH') == 1
            if lagdata{i}(j,1)>0
                lagdata{i}(j,1)=0;
            end
            ht_pred{i}(j,:) =    GARCH{i}.ParamsGARCH(1) + GARCH{i}.ParamsGARCH(2)*resid_pred{i}(j,1).^2 + GARCH{i}.ParamsGARCH(3)*lagdata{i}(j,1)+GARCH{i}.ParamsGARCH(4)*ht_pred{i}(j-1);
        end 
    end
end



